APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# على السيرفر المباشر: https://نطاقك (مهم لبوابة كاشير — رابط العودة يُبنى من APP_URL إن لم تضبط KASHIER_MERCHANT_REDIRECT_URL)
APP_URL=http://localhost
APP_TIMEZONE=Africa/Cairo

# Google OAuth (تسجيل الدخول / إنشاء حساب طالب بـ Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# قرص ملفات مجتمع الذكاء الاصطناعي (تقديمات المساهمين): local أو r2
FILESYSTEM_DISK_COMMUNITY=local
# قرص ملفات التوظيف (CV + مرفقات): r2 (Cloudflare) مع AWS_* أدناه، أو public للتطوير المحلي
FILESYSTEM_DISK_HR_RECRUITMENT=r2
# تسليمات الواجبات + تسليمات الموظفين (ملفات/صور): r2 مع تعبئة AWS_* أدناه، أو public للتطوير المحلي
FILESYSTEM_DISK_ASSIGNMENTS=r2
FILESYSTEM_DISK_EMPLOYEE_DELIVERABLES=r2
# موارد الكورس الأوفلاين/الأونلاين (رفع المدرب): r2 (Cloudflare) مع AWS_* أدناه، أو public للتطوير المحلي
FILESYSTEM_DISK_OFFLINE_RESOURCES=r2
# تسجيلات محاضرات الأوفلاين/الأونلاين (فيديو المدرب → Cloudflare R2 + HTML5 داخل المنصة)
FILESYSTEM_DISK_OFFLINE_LECTURE_RECORDINGS=r2
# الحد الأقصى لحجم فيديو المحاضرة بالميجابايت (1024 = 1GB)
OFFLINE_LECTURE_RECORDING_MAX_MB=1024
# رفع مباشر من المتصفح إلى R2 (يحتاج CORS على الـ bucket). اتركه false للرفع عبر السيرفر
OFFLINE_LECTURE_RECORDING_DIRECT_UPLOAD=false
# تسليمات أنشطة الكورس الأوفلاين (ملفات الطلاب): r2 مع AWS_* أدناه، أو public للتطوير المحلي
FILESYSTEM_DISK_OFFLINE_ACTIVITY_SUBMISSIONS=r2
# صورة البروفايل وصور منشورات المجتمع (تطبيق الطالب) — Cloudflare R2 مع AWS_* أو public محلياً
FILESYSTEM_DISK_STUDENT_MOBILE=r2
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# البريد: لإرسال رمز المصادقة الثنائية (2FA) للأدمن والمدربين عبر SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=info@mindlytics-academy.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@mindlytics-academy.com
MAIL_FROM_NAME="${APP_NAME}"
# Gmail: MAIL_HOST=smtp.gmail.com MAIL_PORT=587 MAIL_USERNAME=you@gmail.com MAIL_PASSWORD=كلمة_مرور_التطبيقات
# عند MAIL_MAILER=log لن يُرسل بريد حقيقي — استخدم smtp لإشعارات مهام الموظفين

# إلزام الأدمن والمدربين بالمصادقة الثنائية (2FA) عبر البريد
ADMIN_2FA_REQUIRED=true

# عام (S3 أو Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# لـ Cloudflare R2: Endpoint من لوحة R2 → Manage R2 API Tokens
# AWS_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
# رابط عام للتحميل / CDN (مفضّل دومينك بدل r2.dev):
# AWS_URL=https://cdn.yourdomain.com
# أو: AWS_URL=https://pub-xxx.r2.dev
AWS_URL=

# بوابة الدفع كاشير — Payment Sessions v3
# مهم: KASHIER_*_API_BASE_URL هو فقط test-api.kashier.io أو api.kashier.io (ليس checkout.kashier.io)
KASHIER_MODE=test
KASHIER_TEST_MID=
KASHIER_TEST_API_KEY=
KASHIER_TEST_SECRET=
KASHIER_TEST_BASE_URL=https://checkout.kashier.io
KASHIER_TEST_API_BASE_URL=https://test-api.kashier.io
KASHIER_LIVE_MID=
KASHIER_LIVE_API_KEY=
KASHIER_LIVE_SECRET=
KASHIER_LIVE_BASE_URL=https://checkout.kashier.io
KASHIER_LIVE_API_BASE_URL=https://api.kashier.io
KASHIER_CURRENCY=EGP
KASHIER_ALLOWED_METHODS=card,wallet,bank_installments
# KASHIER_PAYMENTS_SESSION_BASE=https://payments.kashier.io
# إن تركته فارغاً يُستخدم APP_URL + /checkout/kashier/callback (يُرفع http تلقائياً إلى https)
# KASHIER_MERCHANT_REDIRECT_URL=https://yourdomain.com/checkout/kashier/callback
# إن استمر خطأ merchantRedirect: جرّب true (إرسال الرابط مرمّزاً أولاً)
# KASHIER_ENCODE_MERCHANT_REDIRECT=false
# نادر: Bearer في Authorization — فقط إذا طلبته كاشير
# KASHIER_AUTHORIZATION_BEARER=false
# إن استمر خطأ merchantRedirect: جرّب true (طلب مصغّر فقط) أو غيّر نوع الجلسة
# KASHIER_SESSION_MINIMAL_PAYLOAD=false
# KASHIER_SESSION_TYPE=one-time
# أو: KASHIER_SESSION_TYPE=external

# فواتيرك (Fawaterak) — تكامل iframe للكورسات
FAWATERAK_INTEGRATION=iframe
FAWATERAK_ENV=test
FAWATERAK_VENDOR_KEY=
FAWATERAK_PROVIDER_KEY=
# سر HMAC لـ iframe؛ إن ترك فارغاً يُستخدم FAWATERAK_VENDOR_KEY. استخدمه إن وُجد في لوحة فواتيرك Secret منفصل عن API Key.
# FAWATERAK_HMAC_SECRET=
# Bearer لسكربت الإضافة (pluginConfig.token + تحميل السكربت). إن ترك فارغاً يُستخدم FAWATERAK_VENDOR_KEY.
# FAWATERAK_PLUGIN_BEARER_TOKEN=
# نطاق الـ HMAC عندما لا يُرسل hostname موثوق من المتصفح؛ يجب أن يطابق «IFrame domains» في لوحة فواتيرك (بدون / أخيرة)
# FAWATERAK_IFRAME_DOMAIN=https://127.0.0.1
# طلب getPaymentmethods مع HASH قبل إرجاع pluginConfig (false لتعطيل إن أردت تجاوز الفحص مؤقتاً)
# FAWATERAK_IFRAME_PREFLIGHT=true
FAWATERAK_CURRENCY=EGP
FAWATERAK_VERSION=0
# FAWATERAK_TEST_PLUGIN_URL=https://app.fawaterk.com/fawaterkPlugin/fawaterkPlugin.min.js
# FAWATERAK_LIVE_PLUGIN_URL=https://app.fawaterk.com/fawaterkPlugin/fawaterkPlugin.min.js

# عمولة بوابة الدفع (افتراضي — يمكن تجاوزها من إعدادات النظام بعد الحفظ في JSON)
# GATEWAY_FEE_MODE=none
# GATEWAY_FEE_MODE=percent
# GATEWAY_FEE_PERCENT=2.5
# GATEWAY_FEE_FIXED_EGP=5

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Cloud API — عنوان عام لـ Webhook (HTTPS). إن ترك فارغاً يُستخدم APP_URL.
# WHATSAPP_WEBHOOK_BASE_URL=https://your-domain.com
# WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# WHATSAPP_ASSIGNMENT_STRATEGY=manual_queue
# WHATSAPP_QUEUE_ENABLED=true
# WHATSAPP_NOTIFY_INBOUND=true
# WHATSAPP_NOTIFY_QUEUE=true

# WhatsApp Business — Meta Cloud API
# كل الإعدادات تُدار من لوحة الإدارة: /admin/whatsapp/settings
# (storage/app/site/whatsapp_cloud_settings.json — مشفّرة)
# تحويل تسجيلات المتصفح (WebM) إلى OGG/Opus لرسائل صوتية Voice Note:
# FFMPEG_PATH=/usr/bin/ffmpeg

# Meta Social — Facebook Pages, Messenger & Instagram (Business Suite)
# إعدادات OAuth والـ Webhook تُدار من: /admin/meta-social/settings
# META_SOCIAL_APP_ID=
# META_SOCIAL_APP_SECRET=
# META_SOCIAL_VERIFY_TOKEN=your_webhook_verify_token
# META_SOCIAL_WEBHOOK_BASE_URL=https://your-domain.com
# META_SOCIAL_OAUTH_BASE_URL=https://your-domain.com
# META_SOCIAL_GRAPH_VERSION=v21.0
# META_SOCIAL_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata,pages_messaging,instagram_basic,instagram_manage_messages,business_management
